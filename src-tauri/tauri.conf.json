{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustVueVoice",
  "version": "1.0.0",
  "identifier": "com.rulink.rustvuevoice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
